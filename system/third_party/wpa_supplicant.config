# wpa_supplicant build options for afterglow: nl80211 (the Quest's qcacld driver), WPA2/WPA3 personal
# and the common enterprise methods, a control socket for wpa_cli. No D-Bus, no readline.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=openssl
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_DEBUG_FILE=y
CONFIG_GETRANDOM=y

CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y

CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_MD5=y
CONFIG_PKCS12=y

# Static linking needs libnl-genl's dependency after it
LIBS += -lnl-3
