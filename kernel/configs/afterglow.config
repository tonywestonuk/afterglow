# afterglow's additions to the stock Quest 1 kernel config (appended before olddefconfig)

# USB serial console: a CDC-ACM gadget function, /dev/ttyGS0 on the headset and /dev/cu.usbmodem*
# on a Mac (/dev/ttyACM* on Linux). Stock Android only uses adb (FunctionFS), MTP and NCM.
CONFIG_USB_CONFIGFS_ACM=y
